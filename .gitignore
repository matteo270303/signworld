# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Datasets and weights: local folders, only their placeholder is tracked
data/*
checkpoints/*
!data/.gitkeep
!checkpoints/.gitkeep

# Runtime artefacts
runs/
out/
logs/
*.part

# Local secrets and third-party checkouts (YouTube cookies, PO-token server)
.env
.secrets/
third_party/
/collaudo/
.vscode/launch.json
