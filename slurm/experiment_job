#!/bin/bash

#SBATCH -p boost_usr_prod
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32
#SBATCH --gres=gpu:4
#SBATCH --mem=492000

# Job di slurm/launch_experiment.sh (account, QOS, durata, nodi e log li passa lui): un nodo con
# 4 GPU per esperimento, un srun per nodo, in parallelo. Uso: experiment_job debug|train <esp>...
MODE=$1
shift
pids=()
for exp in "$@"; do
  srun --nodes=1 --ntasks=1 --exclusive --gres=gpu:4 --cpus-per-task=32 --mem=492000 \
    --output="out/sw-$MODE-$exp-%j.log" ./slurm/experiment_exe "$MODE" "$exp" &
  pids+=($!)
done
status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done
# Debug: i nodi sono indipendenti, un esperimento fallito non ferma il secondo segmento degli altri.
[ "$MODE" = debug ] && exit 0
exit $status
