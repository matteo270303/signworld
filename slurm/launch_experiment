#!/bin/bash

#SBATCH -p boost_usr_prod
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32
#SBATCH --gres=gpu:4
#SBATCH --mem=492000
#SBATCH -A IscrC_SPARTAN

# Esperimenti di experiments.sh: un nodo con 4 GPU per esperimento, un srun per nodo, in parallelo.
# Account, QOS, durata, nodi e log del job li passano gli script in slurm/batch/ (debug.sh, wave1.sh, ...).
# Log: un file per job e run, <run>/logs/<mode>-<job>.log, con l'output del programma e i messaggi
# di srun (es. "srun: error: ... exit code 1"), tutti in append.
# Dalla radice del repo: sbatch slurm/launch_experiment debug|train <esp>...
MODE=$1
shift
# Fissa RUN_STAMP per tutti gli srun, se lo sbatch non l'ha già passata (slurm/batch/*.sh).
source slurm/experiments.sh
pids=()
for exp in "$@"; do
  logs=$(run_dir "$MODE" "$exp")/logs
  log=$logs/$MODE-${SLURM_JOB_ID:-local}.log
  mkdir -p "$logs"
  srun --nodes=1 --ntasks=1 --exclusive --gres=gpu:4 --cpus-per-task=32 --mem=492000 \
    --output="$log" --open-mode=append ./slurm/launch_experiment_exe "$MODE" "$exp" >> "$log" 2>&1 &
  pids+=($!)
done
status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done
# Debug: i nodi sono indipendenti, un esperimento fallito non ferma il secondo segmento degli altri.
[ "$MODE" = debug ] && exit 0
exit $status
