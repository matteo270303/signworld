#!/bin/bash
# Un esperimento su un nodo (4 GPU, DDP): un segmento del run, che riparte da
# <run>/checkpoints/latest.pt se c'è. Lanciato da slurm/launch_experiment. Uso: launch_experiment_exe debug|train <esp>

set -euo pipefail

MODE=$1
EXP=$2
# shellcheck source=experiments.sh
source slurm/experiments.sh
experiment_files "$EXP" > /dev/null || exit 1
mapfile -t FILES < <(experiment_files "$EXP")
[ "$MODE" = debug ] && FILES+=(parameters/model/debug_cluster.yaml)
CFG=()
for file in "${FILES[@]}"; do CFG+=(-c "$file"); done
RUN=$(run_dir "$MODE" "$EXP")
mkdir -p "$RUN"

if [ -f "$RUN/checkpoints/final.pt" ]; then
  echo "$RUN: già finito, niente da fare"
  exit 0
fi
if [ -f "$RUN/FAILED" ]; then
  echo "$RUN: fallito in un job precedente ($(cat "$RUN/FAILED")); toglierlo per ripartire" >&2
  exit 1
fi

# Compute nodes have no internet: models come from the $SCRATCH caches only.
export HF_HOME=${SCRATCH:?SCRATCH must name the cache directory}
export TORCH_HOME=$SCRATCH
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}

source .venv/bin/activate

# Lo stop prima del walltime: fine del job meno il margine. Il trainer salva latest e si ferma.
END=$(squeue -h -j "$SLURM_JOB_ID" -o %e 2>/dev/null || true)
if [ -n "$END" ] && END_S=$(date -d "$END" +%s 2>/dev/null); then
  export SIGNWORLD_STOP_AT=$((END_S - ${STOP_MARGIN_MIN:-45} * 60))
  echo "$RUN: fine del job $END, stop e salvataggio dopo $(date -d "@$SIGNWORLD_STOP_AT" +%FT%T)"
else
  echo "ATTENZIONE: fine del job non letta da squeue, nessuno stop prima del walltime" >&2
fi

# Memoria e utilizzo di ogni GPU ogni 30 s: per il debug è la misura che decide sull'OOM.
nvidia-smi --query-gpu=timestamp,index,memory.used,memory.total,utilization.gpu --format=csv,noheader \
  -l 30 >> "$RUN/gpu.csv" &
MONITOR=$!
trap 'kill $MONITOR 2>/dev/null || true' EXIT

EXTRA=()
[ "${ALLOW_CODE_CHANGE:-0}" = 1 ] && EXTRA+=(--allow-code-change)
echo "$RUN: ${FILES[*]}"
status=0
torchrun --standalone --nnodes=1 --nproc_per_node="${SLURM_GPUS_ON_NODE:-4}" --no-python \
  signworld train run "${CFG[@]}" --output "$RUN" "${EXTRA[@]}" || status=$?
if [ $status -ne 0 ]; then
  echo "job ${SLURM_JOB_ID:-?} del $(date +%FT%T), uscita $status" > "$RUN/FAILED"
fi
exit $status
