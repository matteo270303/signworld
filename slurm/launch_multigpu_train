#!/bin/bash

#SBATCH -A IscrC_SPARTAN
#SBATCH -p boost_usr_prod
#SBATCH --qos normal
#SBATCH --time=24:00:00
#SBATCH -N 1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32
#SBATCH --gres=gpu:4
#SBATCH --mem=492000
#SBATCH --job-name=train_mg
#SBATCH --out=out/train_mg.log
#SBATCH --err=out/train_mg.log
#SBATCH --mail-type=FAIL
#SBATCH --mail-user=<EMAIL>

# One WorldSign training run on the 4 GPUs of one node, DDP, one process per GPU (§4.10).
# The batch of 128 is global: P16 requires clips x GPUs = 128, so the GPU count must divide 128
# (1, 2, 4, 8). 4 GPUs give 32 clips each (the measured case). For 2 GPUs (64 clips each, NOT
# measured on a 64 GB A100) override: --gres=gpu:2 --cpus-per-task=16 --mem=246000.
# Launch from the repository root (out/ must exist):
#   sbatch slurm/launch_multigpu_train -c parameters/model/worldsign.yaml -c parameters/ablation/arm_A.yaml --output runs/worldsign-A
srun -u ./slurm/launch_multigpu_train_exe "$@"
