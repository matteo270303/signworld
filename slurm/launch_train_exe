#!/bin/bash
# The run resumes from runs/<name>/checkpoints/latest.pt when the job is repeated.

# Compute nodes have no internet: models come from the $SCRATCH caches only.
export HF_HOME=${SCRATCH:?SCRATCH must name the cache directory}
export TORCH_HOME=$SCRATCH
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
# Data-loader processes do the decoding; keep each process's own threads few.
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}

echo "HF_HOME: $HF_HOME"
echo "TORCH_HOME: $TORCH_HOME"

source .venv/bin/activate

# Less fragmentation of the GPU memory: PyTorch's own advice when the trial ran out of it.
export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}
torchrun --standalone --nnodes=1 --nproc_per_node=${SLURM_GPUS_ON_NODE:-1} \
  --no-python signworld train run "$@"
